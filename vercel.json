{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build" },
    { "src": "backend/src/server.js", "use": "@vercel/node" }
  ],
  "rewrites": [
    {
      "source": "/api/reviews",
      "destination": "/backend/src/server.js"
    },
    {
      "source": "/api/reviews/:productKey",
      "destination": "/backend/src/server.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}